<?xml version="1.0" encoding="UTF-8"?>
<solver>
    
    <solutionClass>com.battbatt.solver.BatteryAssignmentSolution</solutionClass>
    <entityClass>com.battbatt.entity.Battery</entityClass>

    <scoreDirectorFactory>
        <constraintProviderClass>com.battbatt.solver.BatteryConstraintProvider</constraintProviderClass>
    </scoreDirectorFactory>

    <termination>
        <secondsSpentLimit>5</secondsSpentLimit>
    </termination>

</solver>
